# Backend Dockerfile for FastAPI - Multi-stage build for optimization
FROM python:3.11-slim AS builder

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# Install build deps in builder stage
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    gcc \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements and install into a dedicated prefix to keep final image small
COPY src/backend/requirements.txt ./
RUN pip install --no-cache-dir --prefix=/install -r requirements.txt

# Copy application code
COPY src/backend ./src/backend

FROM python:3.11-slim AS runtime

WORKDIR /app/src/backend

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PORT=${PORT:-8000}

# Copy installed packages from builder
COPY --from=builder /install /usr/local

# Copy application code
COPY --from=builder /app/src/backend ./

# Expose port
EXPOSE 8000

# Healthcheck for Kubernetes
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health')" || exit 1

# Run the app
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
